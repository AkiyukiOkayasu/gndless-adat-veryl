import Types::AdatFamily;

/// ADAT TXトップモジュール
///
/// 8ch 24bit PCMをADATフレームへ変換し、NRZI信号として出力
/// `channels`は`gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q1_23>`境界で、raw値は`channels[i].raw`から得る。
/// `AdatRx`の`channels`出力とは同じformatのため、`Smux2Unpacker`と同様に利用側でQ1.23 interfaceを共有できる。
///
/// # 実機確認状況
/// 実機動作は未確認。現時点ではNative testと、RTL内部で接続した`AdatTx`→`AdatRx` loopback testだけを確認している。
/// 外部ADAT機器との相互接続、光送信回路を含む電気的条件、実機上のタイミングは未検証。
///
/// 送信パイプラインは以下の2段で構成される。
///
/// 1. `frame_serializer`
///    - `frame_clk`立ち上がりをトリガに256bit ADATフレームを構築して単一のshift registerへ保持し、MSB-firstでシリアル化
///    - `ADAT_FAMILY`に応じて44.1kHz系/48kHz系のビット周期を選択
/// 2. `nrzi_encoder`
///    - シリアルビットをNRZIへ変換して`adat`へ出力
///
/// # 公開インターフェースの概念タイミング
///
/// 次図は縮尺なし。`frame_clk`の立ち上がりで`channels`を取り込み、256bitのNRZI送信が完了すると`frame_done`をシステムクロック1周期だけHighにする。
/// `adat`の遷移パターンはPCM値によって変わる。
///
/// ```wavedrom
/// {
///   signal: [
///     { name: 'frame_clk', wave: '0.10.........|0.10....' },
///     { name: 'channels',  wave: '3............|4.......', data: ['frame N', 'frame N+1'] },
///     { name: 'adat',      wave: 'x..5........x|..6.....', data: ['NRZI frame N', 'NRZI frame N+1'] },
///     { name: 'frame_done', wave: '0..........10|........' }
///   ],
///   head: { text: 'Conceptual TX timing (not to scale)' }
/// }
/// ```
pub module AdatTx #(
    param CLK_FREQ   : u32        = 50_000_000      , /// システムクロック周波数 [Hz]
    param ADAT_FAMILY: AdatFamily = AdatFamily::F48K, /// ADATビットレートファミリー (44.1kHz系 or 48kHz系)
) (
    clk        : input   clock                                                                           ,
    rst        : input   reset                                                                           ,
    frame_clk  : input   logic                                                                           , /// 外部フレームクロック立ち上がりで新規フレーム送信開始
    channels   : modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q1_23>::input_port [8],
    smux_active: input   bbool                                                                           , /// S/MUX有効フラグ入力
    adat       : output  logic                                                                           , /// ADAT NRZI出力
    frame_done : output  logic                                                                           , /// 256bitフレーム送信完了パルス
) {
    var frame_build_pulse: logic;
    var serial_bit       : logic;
    var serial_bit_valid : logic;
    var serial_frame_done: logic;

    // Gowin合成はprocedural forでinterface配列要素を定数選択できないため、
    // 入力interfaceはgenerate assignでraw配列へ展開する。
    var channels_raw: gndless_fixedpoint::Q1_23::Raw [8];
    for i in 0..8 :g_ch {
        assign channels_raw[i] = channels[i].raw;
    }

    assign frame_done = serial_frame_done;

    // TimecodeやMIDIなどのユーザーデータは常に0とする
    // シリアライザはuser_bitsをMSB-firstで送るため、bit[2] = 送信順で2番目のuser bit。
    // Alesis 2X Sample Rate (96kHz)仕様のS/MUX2フラグ位置 (RME実装と一致)。
    // S/MUX2 (88.2/96kHz) のときだけsmux_activeを1にしてこのフラグを立てる。
    // S/MUX4 (176.4/192kHz) はuser bitフラグを持たない (全0) ため、smux_activeは
    // 0のままにし、受信側はユーザー設定のクロック/レートでS/MUX4を判別する
    // (RME ADI-8 DSマニュアル "No S/MUX4 Flag")。
    // - bit[3] (1番目): 常に0
    // - bit[2] (2番目): S/MUX2フラグはsmux_activeに従う
    // - bit[1] (3番目): 常に0
    // - bit[0] (4番目): 常に0
    var user_bits: logic<4>;
    always_comb {
        if smux_active {
            user_bits = 4'b0100;
        } else {
            user_bits = 4'b0000;
        }
    }

    // フレームクロック立ち上がり検出
    inst u_frame_clk_edge: $std::edge_detector (
        i_clk    : clk              ,
        i_rst    : rst              ,
        i_clear  : 0                ,
        i_data   : frame_clk        ,
        o_edge   : _                ,
        o_posedge: frame_build_pulse,
        o_negedge: _                ,
    );

    // フレーム構築とシリアル化 (256bit単一shift register)
    inst u_frame_serializer: AdatFrameSerializer #(
        CLK_FREQ  ,
    ) (
        clk                          ,
        rst                          ,
        build     : frame_build_pulse,
        channels  : channels_raw     ,
        user_bits : user_bits        ,
        family    : ADAT_FAMILY      ,
        serial_bit: serial_bit       ,
        bit_valid : serial_bit_valid ,
        frame_done: serial_frame_done,
    );

    // NRZIエンコード
    inst u_nrzi_encoder: NrziEncoder (
        clk                         ,
        rst                         ,
        serial_bit: serial_bit      ,
        valid     : serial_bit_valid,
        nrzi      : adat            ,
    );
}
