/// 完全ADATフレームの出力インターフェース
///
/// 受信途中のチャンネルをworking bufferへ隔離し、channel 0から7まで
/// 順序どおりそろった場合だけ8chを一括commitする。S/MUX flagはUserBit2
/// (送信順で2番目のuser bit) の値をS/MUX2として扱う。
/// S/MUX2 (88.2/96kHz) のときだけUserBit2が1になる。S/MUX4 (176.4/192kHz)
/// はuser bitが全0のため検出できず (RME ADI-8 DSマニュアル "No S/MUX4 Flag")、
/// ユーザー側のクロック/レート設定が必要である。
///
/// # フレームクロック
/// ADATフレーム周期のクロック（サンプルクロックではない）。
/// 通常は44.1/48kHzで、S/MUX2有効時の論理sample rateは2倍。フレーム周期の約50%デューティで出力する。
///
/// # frame_valid
/// channel 0から7まで完全な順序で受信・commitした完全frameを1サイクルで通知する。
/// `locked`とは独立したraw commit pulseであり、qualification中やrate/mode
/// transitionのframeでは`frame_valid=1, locked=0`になり得る。下流は
/// `frame_valid && locked`を受理条件にすること。
///
/// # locked
/// 完全フレームの周期安定を確認したときに`locked`をアサートする。
/// 周期変化、S/MUX2 flag変化、frame欠落では解除し、再qualificationを行う。
module OutputInterface (
    clk        : input   clock                                                                                , /// システムクロック
    rst        : input   reset                                                                                , /// リセット
    frame_time : input   logic                                                                        <12>    , /// フレーム時間
    data       : input   logic                                                                        <24>    , /// PCMデータ入力
    channel    : input   logic                                                                        <3>     , /// チャンネル番号
    data_valid : input   logic                                                                                , /// データ有効
    sync       : input   logic                                                                                , /// 同期マスク
    user_bits  : input   logic                                                                        <4>     , /// ユーザービット入力
    smux_active: output  bbool                                                                                , /// 検出されたS/MUX有効状態 (1: 有効, 0: 無効)
    frame_clk  : output  logic                                                                                , /// ADATフレーム周期のクロック出力（サンプルクロックではない）
    channels   : modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q1_23>::output_port     [8], /// 8チャンネルPCMデータ出力
    frame_valid: output  logic                                                                                , /// 完全フレームcommitパルス
    locked     : output  bbool                                                                                , /// 同期ロック状態
) {
    // ワードクロックカウンタ
    var word_clk_cnt: logic<12>;
    // ワードクロック出力
    var word_clk: logic;
    // 受信途中のworking bufferと公開済みcommit buffer
    var working_reg      : logic<24> [8];
    var channel_reg      : logic<24> [8];
    var expected_channel : logic<3>     ;
    var frame_in_progress: logic        ;
    var candidate_smux   : bbool        ;
    var committed_smux   : bbool        ;
    var valid_out        : logic        ;
    var commit_pending   : logic        ;
    var timestamp        : logic<16>    ;
    var lock_reg         : bbool        ;

    assign smux_active = committed_smux;

    assign frame_clk = word_clk;
    // 完全frameのraw commitを1クロック遅延して公開する。lockは独立した
    // qualification状態であり、下流がframe_valid && lockedで受理する。
    assign frame_valid = commit_pending;
    assign locked      = lock_reg;

    // チャンネル出力割り当て
    for i in 0..8 :g_ch_out {
        assign channels[i].raw = channel_reg[i];
    }

    // 完全frameのcommit eventだけをStreamLockQualifierへ渡す。
    // timestampはframe_validの間隔を測るための単調なシステムクロック。
    always_ff {
        if_reset {
            timestamp = 16'd0;
        } else {
            timestamp = timestamp + 16'd1;
        }
    }

    inst u_stream_lock: StreamLockQualifier (
        clk        : clk           ,
        rst        : rst           ,
        frame_valid: valid_out     ,
        smux_active: committed_smux,
        timestamp  : timestamp     ,
        locked     : lock_reg      ,
    );

    // qualifierはvalid_outを1クロック遅れて観測するため、同じcommitを
    // raw frame_validとして公開する。
    always_ff {
        if_reset {
            commit_pending = 1'b0;
        } else {
            commit_pending = valid_out;
        }
    }

    // ワードクロック生成
    // フレーム時間の約50%デューティ
    always_ff {
        if_reset {
            word_clk_cnt = 12'd0;
            word_clk     = 1'b0;
        } else if !sync {
            word_clk_cnt = 12'd0;
            word_clk     = 1'b1;
        } else {
            word_clk_cnt = word_clk_cnt + 12'd1;
            if word_clk_cnt >: (frame_time >> 1) {
                word_clk = 1'b0;
            } else {
                word_clk = 1'b1;
            }
        }
    }

    // チャンネルデータ格納と完全frameのatomic commit
    always_ff {
        if_reset {
            working_reg[0]    = 24'd0;
            working_reg[1]    = 24'd0;
            working_reg[2]    = 24'd0;
            working_reg[3]    = 24'd0;
            working_reg[4]    = 24'd0;
            working_reg[5]    = 24'd0;
            working_reg[6]    = 24'd0;
            working_reg[7]    = 24'd0;
            channel_reg[0]    = 24'd0;
            channel_reg[1]    = 24'd0;
            channel_reg[2]    = 24'd0;
            channel_reg[3]    = 24'd0;
            channel_reg[4]    = 24'd0;
            channel_reg[5]    = 24'd0;
            channel_reg[6]    = 24'd0;
            channel_reg[7]    = 24'd0;
            expected_channel  = 3'd0;
            frame_in_progress = 1'b0;
            candidate_smux    = 1'b0;
            committed_smux    = 1'b0;
            valid_out         = 1'b0;
        } else if data_valid {
            valid_out = 1'b0;
            if channel == 3'd0 {
                // channel 0は常に新しいcandidate frameの開始とする。
                working_reg[0]    = data;
                expected_channel  = 3'd1;
                candidate_smux    = if user_bits[1] ? true : false;
                frame_in_progress = 1'b1;
            } else if frame_in_progress && channel == expected_channel {
                if channel == 3'd7 {
                    // channel 7のpayloadを含め、8chを同じedgeで公開する。
                    channel_reg[0]    = working_reg[0];
                    channel_reg[1]    = working_reg[1];
                    channel_reg[2]    = working_reg[2];
                    channel_reg[3]    = working_reg[3];
                    channel_reg[4]    = working_reg[4];
                    channel_reg[5]    = working_reg[5];
                    channel_reg[6]    = working_reg[6];
                    channel_reg[7]    = data;
                    committed_smux    = candidate_smux;
                    expected_channel  = 3'd0;
                    frame_in_progress = 1'b0;
                    valid_out         = 1'b1;
                } else {
                    working_reg[channel] = data;
                    expected_channel     = expected_channel + 3'd1;
                }
            } else {
                // 不完全/順序異常candidateは破棄し、次のchannel 0を待つ。
                expected_channel  = 3'd0;
                frame_in_progress = 1'b0;
            }
        } else {
            valid_out = 1'b0;
        }
    }
}

/// 8channel受信後のatomic commit、frame_valid pulse、S/MUX2 flagを検証
#[test(test_adat_output_interface)]
module test_adat_output_interface {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var frame_time : logic<12>;
    var data       : logic<24>;
    var channel    : logic<3> ;
    var data_valid : logic    ;
    var sync       : logic    ;
    var user_bits  : logic<4> ;
    var smux_active: bbool    ;
    var frame_clk  : logic    ;
    inst channels: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q1_23> [8];
    var frame_valid    : logic;
    var locked         : bbool;
    var raw_seen       : logic;
    var transition_seen: logic;

    inst dut: OutputInterface (
        clk          ,
        rst          ,
        frame_time   ,
        data         ,
        channel      ,
        data_valid   ,
        sync         ,
        user_bits    ,
        smux_active  ,
        frame_clk    ,
        channels     ,
        frame_valid  ,
        locked       ,
    );

    function push_channel (
        index : input logic<3> ,
        sample: input logic<24>,
    ) {
        channel    = index;
        data       = sample;
        data_valid = 1'b1;
        clk.next(1);
        data_valid = 1'b0;
        if frame_valid {
            raw_seen = 1'b1;
            if !locked {
                transition_seen = 1'b1;
            }
        }
    }

    function push_frame () {
        push_channel(3'd0, 24'h100000);
        push_channel(3'd1, 24'h200000);
        push_channel(3'd2, 24'h300000);
        push_channel(3'd3, 24'h400000);
        push_channel(3'd4, 24'h500000);
        push_channel(3'd5, 24'h600000);
        push_channel(3'd6, 24'h700000);
        push_channel(3'd7, 24'h7FFFFF);
    }

    initial {
        frame_time      = 12'd2048;
        data            = 24'd0;
        channel         = 3'd0;
        data_valid      = 1'b0;
        sync            = 1'b1;
        user_bits       = 4'b0010;
        raw_seen        = 1'b0;
        transition_seen = 1'b0;
        rst.assert();

        // 欠落channelを含むcandidateは公開bufferを更新しない。
        push_channel(3'd0, 24'hAAAAAA);
        push_channel(3'd1, 24'hBBBBBB);
        push_channel(3'd7, 24'hCCCCCC);
        $assert(frame_valid == 1'b0, "incomplete frame must not assert frame_valid");
        $assert(channels[0].raw == 24'd0, "incomplete frame leaked channel 0");

        // 最初の完全frameはatomic commitされ、次cycleにraw pulseを公開する。
        push_channel(3'd0, 24'h100000);
        push_channel(3'd1, 24'h200000);
        push_channel(3'd2, 24'h300000);
        push_channel(3'd3, 24'h400000);
        push_channel(3'd4, 24'h500000);
        push_channel(3'd5, 24'h600000);
        push_channel(3'd6, 24'h700000);
        push_channel(3'd7, 24'h7FFFFF);

        $assert(frame_valid == 1'b0, "frame_valid is delayed until the commit pulse");
        clk.next(1);
        $assert(frame_valid == 1'b1, "complete frame must emit raw frame_valid");
        $assert(locked == 1'b0, "first frame must be visible before qualification");
        $assert(smux_active == 1'b1, "S/MUX flag mismatch");
        $assert(channels[0].raw == 24'h100000, "channel 0 data mismatch");
        $assert(channels[7].raw == 24'h7FFFFF, "channel 7 data mismatch");

        // 32個の安定interval後にqualifierがlockする。raw frame_validは
        // qualification中も各atomic commitで発生する。
        for _i in 0..34 {
            push_frame();
        }
        clk.next(1);
        $assert(locked == 1'b1, "stable stream should lock");
        $assert(raw_seen == 1'b1, "raw frame_valid was not observed");

        // S/MUX mode transitionのcommitはraw pulseを出すが、lockは解除する。
        user_bits = 4'b0000;
        push_frame();
        clk.next(1);
        $assert(frame_valid == 1'b1, "mode transition must emit raw frame_valid");
        $assert(locked == 1'b0, "mode transition frame must not be locked");
        $assert(transition_seen == 1'b1, "unlocked raw frame_valid was not observed");
        $finish();
    }
}
