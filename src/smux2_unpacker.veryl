/// S/MUX2の8物理スロットを4chの高速サンプルへ戻す
///
/// 1つのADATフレームを受けたサイクルで先行サンプルを出力し、次のシステムクロックで後続サンプルを出力する。
/// したがって、`frame_valid` 1回に対して `sample_valid` は2クロック連続でHighになる。
/// `frame_valid`は、後続サンプルの出力が終わるまで再度アサートしないこと。
/// `channels`と`samples`は`gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q1_23>`境界であり、
/// `AdatRx`の`channels`出力へ直接接続できる。
///
/// ```wavedrom
/// {
///   signal: [
///     { name: 'clk',          wave: 'p.....' },
///     { name: 'frame_valid',  wave: '010...' },
///     { name: 'channels',     wave: 'x3....', data: ['A0,B0,A1,B1,A2,B2,A3,B3'] },
///     { name: 'samples',      wave: 'x45...', data: ['A[0..3]', 'B[0..3]'] },
///     { name: 'sample_valid', wave: '01.0..' }
///   ]
/// }
/// ```
pub module Smux2Unpacker (
    clk         : input   clock                                                                            ,
    rst         : input   reset                                                                            ,
    channels    : modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q1_23>::input_port  [8],
    frame_valid : input   logic                                                                            ,
    samples     : modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q1_23>::output_port [4],
    sample_valid: output  logic                                                                            ,
) {
    var second_samples: gndless_fixedpoint::Q1_23::Raw [4];
    var samples_reg   : gndless_fixedpoint::Q1_23::Raw [4];
    var emit_second   : logic                             ;

    always_ff {
        if_reset {
            second_samples[0] = 0;
            second_samples[1] = 0;
            second_samples[2] = 0;
            second_samples[3] = 0;
            samples_reg[0]    = 0;
            samples_reg[1]    = 0;
            samples_reg[2]    = 0;
            samples_reg[3]    = 0;
            emit_second       = 1'b0;
            sample_valid      = 1'b0;
        } else {
            sample_valid = 1'b0;

            if emit_second {
                samples_reg[0] = second_samples[0];
                samples_reg[1] = second_samples[1];
                samples_reg[2] = second_samples[2];
                samples_reg[3] = second_samples[3];
                emit_second    = 1'b0;
                sample_valid   = 1'b1;
            } else if frame_valid {
                samples_reg[0]    = channels[0].raw;
                samples_reg[1]    = channels[2].raw;
                samples_reg[2]    = channels[4].raw;
                samples_reg[3]    = channels[6].raw;
                second_samples[0] = channels[1].raw;
                second_samples[1] = channels[3].raw;
                second_samples[2] = channels[5].raw;
                second_samples[3] = channels[7].raw;
                emit_second       = 1'b1;
                sample_valid      = 1'b1;
            }
        }
    }

    for i in 0..4 :g_out {
        assign samples[i].raw = samples_reg[i];
    }
}

/// pack後のframeをunpackし、S/MUX2のsample順序が復元されることを検証
///
/// packer→unpackerをQ1.23 interfaceで直接接続し、module境界の整合も同時に確認する。
#[test(test_smux2_pack_unpack)]
module test_smux2_pack_unpack {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var input_valid: logic;
    inst input_samples  : gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q1_23> [4];
    inst packed_channels: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q1_23> [8];
    var packed_valid: logic;
    inst unpacker_samples: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q1_23> [4];
    var unpacked_valid: logic;

    inst packer: Smux2Packer (
        clk         : clk            ,
        rst         : rst            ,
        sample_valid: input_valid    ,
        samples     : input_samples  ,
        channels    : packed_channels,
        frame_valid : packed_valid   ,
    );
    inst unpacker: Smux2Unpacker (
        clk         : clk             ,
        rst         : rst             ,
        channels    : packed_channels ,
        frame_valid : packed_valid    ,
        samples     : unpacker_samples,
        sample_valid: unpacked_valid  ,
    );

    initial {
        input_valid          = 1'b0;
        input_samples[0].raw = 24'h000001;
        input_samples[1].raw = 24'h000002;
        input_samples[2].raw = 24'h000003;
        input_samples[3].raw = 24'h000004;
        rst.assert();

        input_valid = 1'b1;
        clk.next(1);
        input_valid = 1'b0;
        $assert(packed_valid == 1'b0, "first sample must be buffered");

        input_samples[0].raw = 24'h100001;
        input_samples[1].raw = 24'h100002;
        input_samples[2].raw = 24'h100003;
        input_samples[3].raw = 24'h100004;
        input_valid          = 1'b1;
        clk.next(1);
        input_valid = 1'b0;

        $assert(packed_valid == 1'b1, "second sample must complete a frame");
        $assert(packed_channels[0].raw == 24'h000001, "CH0 first sample mismatch");
        $assert(packed_channels[1].raw == 24'h100001, "CH0 second sample mismatch");
        $assert(packed_channels[2].raw == 24'h000002, "CH1 first sample mismatch");
        $assert(packed_channels[3].raw == 24'h100002, "CH1 second sample mismatch");

        clk.next(1);
        $assert(unpacked_valid == 1'b1, "first unpacked sample must be valid");
        $assert(unpacker_samples[0].raw == 24'h000001, "unpacked CH0 first mismatch");
        $assert(unpacker_samples[3].raw == 24'h000004, "unpacked CH3 first mismatch");

        clk.next(1);
        $assert(unpacked_valid == 1'b1, "second unpacked sample must be valid");
        $assert(unpacker_samples[0].raw == 24'h100001, "unpacked CH0 second mismatch");
        $assert(unpacker_samples[3].raw == 24'h100004, "unpacked CH3 second mismatch");

        clk.next(1);
        $assert(unpacked_valid == 1'b0, "unpacker valid must be a pulse");
        $finish();
    }
}
